APP_NAME=FamilyManager
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_CH

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=familymanager
DB_USERNAME=familymanager_user
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=file
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_EXPIRE_ON_CLOSE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BCRYPT_ROUNDS=12

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# SMTP for sender verification. Use the exact provider host; TLS is required.
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional IMAP invitation import; activate only after completing INSTALLATION.md.
CALENDAR_MAIL_ENABLED=false
CALENDAR_MAIL_REQUIRE_AUTHENTICATION=true
CALENDAR_MAIL_ADDRESS=familie@aufbollen.ch
CALENDAR_MAIL_HOST=
CALENDAR_MAIL_PORT=993
CALENDAR_MAIL_USERNAME=familie@aufbollen.ch
CALENDAR_MAIL_PASSWORD=
CALENDAR_MAIL_FOLDER=INBOX
# Exact authserv-id values from the receiving server, after confirming RFC 8601 header sanitization.
CALENDAR_MAIL_TRUSTED_AUTHSERV_IDS=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_TIMEOUT=60

VITE_APP_NAME="${APP_NAME}"

FORCE_HTTPS=true
REGISTRATION_ENABLED=true
SESSION_SECURE_COOKIE=false
HASH_DRIVER=bcrypt
# Existing bcrypt passwords are verified and rehashed to Argon2id on login.
HASH_VERIFY=false
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
AUDIT_RETENTION_DAYS=180

# Comma-separated exact HTTP(S) origins allowed to embed public share pages. Empty denies framing.
PUBLIC_FRAME_ORIGINS=
