APP_NAME=FamilyManager
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://deine-domain.ch

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_CH

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=metanet_db_name
DB_USERNAME=metanet_db_user
DB_PASSWORD=metanet_db_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=file
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_EXPIRE_ON_CLOSE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BCRYPT_ROUNDS=12

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@deine-domain.ch"
MAIL_FROM_NAME="${APP_NAME}"

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_TIMEOUT=60

VITE_APP_NAME="${APP_NAME}"

FORCE_HTTPS=true
REGISTRATION_ENABLED=false
SESSION_SECURE_COOKIE=true
HASH_DRIVER=argon2id
# Existing bcrypt passwords are verified and rehashed to Argon2id on login.
HASH_VERIFY=false
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
AUDIT_RETENTION_DAYS=180
